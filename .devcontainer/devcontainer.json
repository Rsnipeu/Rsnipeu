{
  "name": "my-project-devcontainer",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20",
      "nodeGyp Dependencies": "true",
      "pnpm Version": "latest",
      "nvm Version": "latest",
      "install YarnUsingApt": "true"
    },
    "ghcr.io/dotnet/aspire-devcontainer-feature/dotnetaspire:1": {
      "version": "latest"
    },
    "ghcr.io/nikiforovall/devcontainer-features/dotnet-csharpier:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:1": {
      "version": "latest",
      "moby": "true"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.vscode-dotnet-runtime",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-docker",
        "streetsidesoftware.code-spell-checker"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "files.autoSave": "onFocusChange",
        "eslint.enable": true,
        "csharp.format.enable": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  },
  "forwardPorts": [
    3000,   // Node.js dev server
    5000,   // .NET Aspire dashboard
    8080,   // Generic web service
    5432    // Postgres database
  ],
  "postCreateCommand": "dotnet restore && pnpm install",
  "postStartCommand": "dotnet run --project src/MyAspireApp & pnpm dev",
  "workspaceFolder": "/workspace",
  "runArgs": [
    "--init",
    "--privileged"
  ],
  "containerEnv": {
    "POSTGRES_USER": "devuser",
    "POSTGRES_PASSWORD": "devpass",
    "POSTGRES_DB": "mydb"
  }
}
